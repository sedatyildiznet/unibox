{
  "name": "unibox",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "build": "pnpm --dir apps/desktop build",
    "tauri": "pnpm --dir apps/desktop tauri",
    "check": "pnpm --dir apps/desktop check",
    "test": "node --experimental-strip-types --test apps/desktop/tests/*.test.mjs"
  },
  "pnpm": {
    "overrides": {
      "electron-to-chromium": "1.5.400",
      "node-releases": "2.0.36"
    }
  }
}
